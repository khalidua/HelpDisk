{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Logs the SQL EF Core generates. Noisy, and genuinely worth reading
      // while learning: you can watch the global soft-delete query filter
      // append "WHERE IsDeleted = 0" to queries that never mentioned it, and
      // see a Remove() go out as an UPDATE rather than a DELETE.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
